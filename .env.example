# ==========================================
# DocuMind AI — Environment Configuration
# ==========================================

# Core Application
PROJECT_NAME="DocuMind AI"
ENVIRONMENT=production # development | production | test
DEBUG=false
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Relational Database
# SQLite (Local Dev): sqlite+aiosqlite:///./documind_ai.db
# PostgreSQL (Production): postgresql+asyncpg://postgres:postgrespassword@localhost:5432/documind_ai
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/documind_ai

# Security & Authentication (Argon2id + JWT)
# Generate a secure 256-bit key using: openssl rand -base64 32
SECRET_KEY=replace-with-a-secure-random-32-byte-base64-secret-key
SESSION_COOKIE_NAME=documind_session
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=30
SECURE_COOKIE=false # Set to true in HTTPS production environments
COOKIE_SAMESITE=lax

# Email Verification & Notifications
EMAIL_PROVIDER=console # console | smtp | sendgrid | resend
REQUIRE_EMAIL_VERIFICATION=false

# LLM Inference Provider (Groq High-Speed Engine)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
# Available Groq Models:
# - llama-3.3-70b-versatile
# - llama-3.1-8b-instant
# - mixtral-8x7b-32768
# - gemma2-9b-it
# - deepseek-r1-distill-llama-70b
GROQ_MODEL=llama-3.3-70b-versatile

# Document Ingestion & RAG Settings
EMBEDDING_PROVIDER=local
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_UPLOAD_SIZE_MB=50
OCR_ENABLED=true
STORAGE_BACKEND=local # local | s3
STORAGE_LOCAL_PATH=./storage/uploads

# Observability
LOG_LEVEL=INFO


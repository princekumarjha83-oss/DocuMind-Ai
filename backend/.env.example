PROJECT_NAME="DocuMind AI"
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./documind_ai.db
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.vckcab0.mongodb.net/documind_ai?retryWrites=true&w=majority
SECRET_KEY=change_this_to_a_cryptographically_secure_32_byte_secret_key_in_production
SESSION_COOKIE_NAME=documind_session
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=30
SECURE_COOKIE=false
COOKIE_SAMESITE=lax
EMAIL_PROVIDER=console
REQUIRE_EMAIL_VERIFICATION=false
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Groq Cloud Ultra-Fast Inference (Exclusive LLM Provider)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Document Intelligence Configuration
EMBEDDING_PROVIDER=local
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_UPLOAD_SIZE_MB=50
OCR_ENABLED=true
